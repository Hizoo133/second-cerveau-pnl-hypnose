# Configuration pour le pipeline d'extraction Gemini 3.8 Flash
# Obtenez votre clé API sur https://aistudio.google.com/app/apikey

GEMINI_API_KEY=your_gemini_api_key_here

# Modèle cible (gemini-3.8-flash recommandé pour 1M tokens contexte et 64k sortie)
GEMINI_MODEL=gemini-3.8-flash

# Concurrence d'extraction (nombre de workers asynchrones)
MAX_WORKERS=4

# Paramètres de découpage (anti-compression)
CHUNK_SIZE=25000
CHUNK_OVERLAP=1500
